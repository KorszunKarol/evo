namespace evolution.genome;

enum ShapeType : ubyte { Sphere = 0, CapsuleY = 1, Box = 2 }
enum BrainKind : ubyte { MLP = 0, NEAT = 1 }
enum NodeType : ubyte { Input = 0, Hidden = 1, Output = 2 }
enum Activation : ubyte { Linear = 0, Tanh = 1, Relu = 2, Sigmoid = 3 }

/// Dietary preference that determines what entities can be consumed for energy.
enum DietPreference : ubyte { 
  /// Consumes plants only.
  Herbivore = 0,
  /// Consumes other creatures only.
  Carnivore = 1,
  /// Can consume both (future: reduced efficiency).
  Omnivore = 2
}

table Vec3F {
  x: float;
  y: float;
  z: float;
}

enum JointType : ubyte { Fixed = 0, Hinge = 1, Spherical = 2 }

table Joint {
  type: JointType;
  axis: Vec3F;          // Local axis for hinge
  limits: Vec3F;        // x=min, y=max (radians)
  anchor: Vec3F;        // Local anchor position relative to child
}

table BodyNode {
  shape: ShapeType;
  size: Vec3F;          // sphere: x=radius; capsule: x=radius, y=halfHeight; box: half extents
  mass_density: float;  // kg/m^3 equivalent
  color: Vec3F;         // debug/render tint
  
  // Articulation
  children: [BodyNode];
  joint_to_parent: Joint;
  transform: Vec3F;     // Relative position to parent (rotation assumed identity for MVP or added later)
}

table MLP {
  input_count: uint32;
  output_count: uint32;
  hidden_layers: [uint32];  // e.g., [16, 16]
  weights: [float];         // packed row-major for all layers
  biases: [float];          // packed biases for all layers
  update_rate_hz: float;    // controller update frequency
}

table NeatNode {
  id: uint32;
  type: NodeType;
  bias: float;
  act: Activation;
}

table NeatConn {
  in: uint32;
  out: uint32;
  weight: float;
  enabled: bool;
  innovation: uint32;
  recurrent: bool;
}

table NEAT {
  input_count: uint32;
  output_count: uint32;
  nodes: [NeatNode];
  conns: [NeatConn];
  update_rate_hz: float;
}

table ModulePlasticity {
  bias_coeffs: [float];
  scale_coeffs: [float];
  trace_gain: float = 0.0;
  trace_decay: float = 0.0;
}

table BrainModule {
  kind: BrainKind;
  mlp: MLP;
  neat: NEAT;
  plasticity: ModulePlasticity;
}

table BrainGating {
  context_size: uint32 = 0;
  epsilon: float = 0.05;
  mlp: MLP;
}

table PreferenceNet {
  mlp: MLP;
  trait_scale: float = 1.0;
}

table Mutator {
  mutate_rate_struct: float = 0.05;
  mutate_rate_param: float = 0.2;
  weight_sigma: float = 0.2;
  module_duplication_rate: float = 0.01;
}

table LifeStage {
  age: float;
  gate_multipliers: [float];
  energy_scale: float = 1.0;
  size_scale: float = 1.0;
  reproduction_allowed: bool = true;
}

table TraitsCache {
  mass: float;
  basal_rate: float;
  brain_cost: float;
  brain_params: float;
  module_count: uint16;
  trait_latent: [float];
}

/// Sensory system parameters determining perception capabilities.
table SensoryTraits {
  /// Maximum vision distance in meters.
  vision_range: float = 10.0;
  /// Field of view in radians (1.57 = 90 degrees).
  vision_fov: float = 1.57;
  /// Number of vision rays (3-16).
  vision_rays: uint8 = 5;
  /// Chemical sensing range in meters (smell food/predators).
  chemical_range: float = 5.0;
}

/// Locomotion parameters affecting movement capabilities and costs.
table LocomotionTraits {
  /// Muscle strength multiplier (affects force and energy cost).
  muscle_strength: float = 1.0;
  /// Turn agility multiplier (affects rotation speed).
  turn_agility: float = 1.0;
  /// Jump power multiplier.
  jump_power: float = 1.0;
  /// Sprint speed multiplier (uses more energy).
  sprint_multiplier: float = 1.0;
}

/// Metabolic parameters affecting energy economy.
table MetabolismTraits {
  /// Basal metabolic rate multiplier.
  basal_modifier: float = 1.0;
  /// Digestion efficiency (energy extracted from food).
  digestion_efficiency: float = 1.0;
  /// Energy storage capacity multiplier.
  energy_capacity_scale: float = 1.0;
  /// Starvation tolerance (survives longer at zero energy).
  starvation_tolerance: float = 1.0;
}

/// Behavioral bias genes affecting decision tendencies.
table BehaviorBias {
  /// Aggression tendency (-1 = flee, +1 = attack).
  aggression: float = 0.0;
  /// Exploration tendency (-1 = stay put, +1 = wander).
  exploration: float = 0.0;
  /// Sociality tendency (-1 = solitary, +1 = group).
  sociality: float = 0.0;
  /// Fear response strength (0 = bold, 1 = cautious).
  fear: float = 0.5;
}

table Genome {
  version: uint16;
  id: uint64;
  generation: uint32;
  parents: [uint64];
  rng_seed: uint64;
  body: BodyNode;
  brain_kind: BrainKind;
  mlp: MLP;
  neat: NEAT;
  modules: [BrainModule];
  gating: BrainGating;
  preference: PreferenceNet;
  mutator: Mutator;
  hotspots: [uint32];
  life_stages: [LifeStage];
  cached: TraitsCache;
  
  /// Dietary preference determining feeding behavior.
  diet: DietPreference = Herbivore;
  /// Attack reach for carnivores (meters).
  attack_reach: float = 1.5;
  /// Energy drain rate when attacking prey (energy/second).
  attack_power: float = 8.0;
  /// Movement speed multiplier (1.0 = baseline).
  speed_trait: float = 1.0;
  
  /// Sensory system traits (vision, smell).
  sensory: SensoryTraits;
  /// Locomotion traits (muscles, agility).
  locomotion: LocomotionTraits;
  /// Metabolic traits (energy economy).
  metabolism: MetabolismTraits;
  /// Behavioral bias genes.
  behavior: BehaviorBias;
}

root_type Genome;


