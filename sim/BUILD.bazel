cc_library(
    name = "sim_core",
    srcs = [
        "src/physics_system.cpp",
        "src/scheduler.cpp",
        "src/simulation_app.cpp",
    ],
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    copts = ["-std=c++20"],
    deps = [
        "@entt//:entt",
        "@spdlog//:spdlog",
