CompileFlags:
  Add:
    # clangd in this environment does not discover libstdc++ headers via driver probing.
    - -isystem
    - /usr/include/c++/11
    - -isystem
    - /usr/include/x86_64-linux-gnu/c++/11
    - -isystem
    - /usr/include/c++/11/backward
    - -isystem
    - /usr/lib/gcc/x86_64-linux-gnu/11/include
    - -isystem
    - /usr/include/x86_64-linux-gnu
    - -isystem
    - /usr/include
